# .env.example —— 复制为 .env 并填上真值。.env 已在 .gitignore 里
POSTGRES_PASSWORD=change_me_pg
STORAGE_ACCESS_KEY=brickkit
STORAGE_SECRET_KEY=change_me_storage
MQ_USER=brickkit
MQ_PASSWORD=change_me_mq
KEYCLOAK_ADMIN_PASSWORD=change_me_kc
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# 5 个外壳登录角色的密码（决策 3、§13.3 铁律二：组件角色 NOLOGIN，只有
# 这 5 个能登录，合并态下 62 个组件共享这 5 个连接池）。be-ops db-script
# 产出的建库脚本要靠这几个变量把密码塞进 CREATE ROLE，见 make db-init。
SHELL_GO_CORE_PASSWORD=change_me_shell_go_core
SHELL_GO_BACKOFFICE_PASSWORD=change_me_shell_go_backoffice
SHELL_GO_INFRA_PASSWORD=change_me_shell_go_infra
SHELL_PY_BRAIN_PASSWORD=change_me_shell_py_brain
SHELL_PY_RENDER_PASSWORD=change_me_shell_py_render

# infra-iam-casdoor（阶段三 Task 7）：本地开发密钥/自签证书，与其它组件
# 密码同级别对待。APP_TOKEN_SIGNING_KEY_PEM 是一份 PKCS#8 PEM 私钥（多行，
# 整体用双引号包起来），本地可以用
# `openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048` 自签一份。
CASDOOR_ADMIN_PASSWORD=change_me_casdoor
WEBHOOK_SHARED_SECRET=change_me_webhook_secret
APP_TOKEN_SIGNING_KEY_PEM="change_me_pem_private_key"

# integration-im-dingtalk（阶段三 Task 9）：钉钉"企业内部应用"的凭据——
# 去 open.dingtalk.com 建一个免费个人团队 + 企业内部应用即可拿到，不需要
# 真实企业营业执照。三项分别对应钉钉后台的 Client ID（原 AppKey）/
# Client Secret（原 AppSecret）/ AgentId（纯数字）。不填就是占位值，
# 组件仍能启动，但真的调钉钉 API 那一步会失败（详见
# components/integration/im-dingtalk/README.md）。
DINGTALK_APP_KEY=change_me_dingtalk_app_key
DINGTALK_APP_SECRET=change_me_dingtalk_app_secret
DINGTALK_AGENT_ID=0
