# Variant alpine: the Python probe as test/probe-py builds it today (official python:3.15.0-alpine: musl, GCC, LTO, no PGO).
FROM python:3.15.0-alpine AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /bin/uv
RUN apk add --no-cache git
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY . .
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.15.0-alpine
COPY --from=build /app/.venv /app/.venv
# the port the image declares, as the probes' own images do (8601 test/probe-py, 8605 test/probe-py2)
ARG PORT=8601
ENV PATH=/app/.venv/bin:$PATH PORT=$PORT
ENTRYPOINT ["python", "-m", "probe_py"]
