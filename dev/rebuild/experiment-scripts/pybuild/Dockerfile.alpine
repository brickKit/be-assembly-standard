# Variant alpine: the Python probe as test/probe-py builds it today (official python:3.15.0-alpine: musl, GCC, LTO, no PGO).
FROM python:3.15.0-alpine AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /bin/uv
RUN apk add --no-cache git
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY . .
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.15.0-alpine
COPY --from=build /app/.venv /app/.venv
# no PORT: BrickKit sets it to the manifest's port (CLI 1.10.1+, FRB-009)
ENV PATH=/app/.venv/bin:$PATH
ENTRYPOINT ["python", "-m", "probe_py"]
